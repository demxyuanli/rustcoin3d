[package]
name = "rc3d-shape"
version.workspace = true
edition.workspace = true
rust-version.workspace = true

[features]
default = []
step-agent-debug = []

[dependencies]
rc3d-core = { workspace = true }
slotmap = { workspace = true }
thiserror = { workspace = true }
log = { workspace = true }
rayon = { workspace = true }
rc3d-nurbs = { workspace = true }
rc3d-mesh = { workspace = true }

[dev-dependencies]
criterion = { version = "0.5", features = ["html_reports"] }
rand = "0.8"

[[bench]]
name = "bspline_eval"
harness = false

[[bench]]
name = "properties"
harness = false

[[bench]]
name = "spatial_index"
harness = false

[[bench]]
harness = false
